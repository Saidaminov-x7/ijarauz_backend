# apps/api/.env.example

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ijarauz
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret_jwt_key_for_dev_only_minimum_32_chars
REFRESH_SECRET=supersecret_refresh_key_for_dev_only_min_32_chars
ENCRYPTION_KEY=32_byte_encryption_key_for_dev_only_1234567890

# CORS — список доменов через запятую
# Добавь домены фронтенда и админ-панели
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://ijara.uz,https://admin.ijara.uz

# Google OAuth (client-side @react-oauth/google)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Telegram 2FA Bot (для авторизации в админ-панели)
TELEGRAM_BOT_TOKEN=8948945605:AAEuAw2oPTRChsWJU5fyu7D53pb4gtCXpKg
TELEGRAM_ADMIN_CHAT_ID=

# Media Storage (local или cloudinary)
# Если указаны ключи CLOUDINARY_*, бэкенд автоматически использует Cloudinary
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=ijarauz/listings
STORAGE_PATH=/tmp/uploads
MAX_FILE_SIZE=10485760

# AI сервис
OLLAMA_BASE_URL=http://localhost:11434
AI_SERVICE_URL=http://localhost:8000
OLLAMA_MODEL=llama3

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute