# apps/api/.env.example

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ijarauz
REDIS_URL=redis://redis:6379
JWT_SECRET=supersecret_jwt_key_for_dev_only_minimum_32_chars
REFRESH_SECRET=supersecret_refresh_key_for_dev_only_min_32_chars
ENCRYPTION_KEY=32_byte_encryption_key_for_dev_only_1234567890

# CORS — список доменов через запятую
# Добавь домен своей админки (localhost:5173 для Vite dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Google OAuth (client-side @react-oauth/google)
# Получи в Google Cloud Console: APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here

# AI сервис
OLLAMA_BASE_URL=http://ollama:11434
AI_SERVICE_URL=http://ai-service:8000