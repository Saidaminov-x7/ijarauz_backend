# ============================================================
# ijarauz_backend — Полная конфигурация переменных окружения
# Скопируй в Railway → Variables сервиса API
# ============================================================

# ─── 1. Окружение и сервер ────────────────────────────────────
# Режим работы: production | development | test
NODE_ENV=production

# Порт приложения (Railway проставляет автоматически в переменную $PORT)
PORT=3000

# Уровень логирования (Pino): fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── 2. База данных PostgreSQL ─────────────────────────────────
# Railway PostgreSQL: привяжи через Variable Reference ${{Postgres.DATABASE_URL}}
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway

# ─── 3. Redis (кэширование, rate-limit, blacklist токенов) ────
# Railway Redis: привяжи через Variable Reference ${{Redis.REDIS_URL}}
# Формат: redis://default:password@containers-us-west-xxx.railway.app:6379
REDIS_URL=redis://default:password@containers-us-west-xxx.railway.app:6379

# ─── 4. Безопасность и JWT ────────────────────────────────────
# Сгенерируй случайные ключи (команда: openssl rand -hex 32)
# JWT_SECRET используется для подписи Access-токенов (время жизни 15 минут)
# JWT_SECRET должен быть задан в .env, иначе приложение не запустится
# JWT_SECRET=

# REFRESH_SECRET используется для подписи Refresh-токенов (время жизни 7 дней)
REFRESH_SECRET=e7a2b9c4f1d8e3a5c7f2b6a9d1e4f8c2b5e7a1d3f9c4b8e2a6d1f5c7b3e9a4f2

# Пароль супер-администратора для выполнения prisma/seed.ts (ОБЯЗАТЕЛЬНО, не коммитить реальный пароль в git)
SEED_ADMIN_PASSWORD=your_secure_superadmin_password

# ─── 5. CORS ──────────────────────────────────────────────────
# Список доверенных доменов фронтенда через запятую (БЕЗ пробелов и слешей на конце)
# Пример: https://ijarauz.uz,https://www.ijarauz.uz,https://ijarauz-frontend.vercel.app
CORS_ORIGINS=https://ijarauz.uz,https://www.ijarauz.uz

# ─── 6. Хранилище медиафайлов (Storage Adapter) ───────────────
# Драйвер хранения: 'cloudinary' (для продакшена) или 'local' (для локальной разработки / Railway Volume)
STORAGE_DRIVER=cloudinary

# Если STORAGE_DRIVER=local:
# Путь на диске для файлов (на Railway Volume укажи путь маунта, например /data/uploads)
STORAGE_PATH=/tmp/uploads

# Максимальный размер загружаемого файла в байтах (10 MB = 10485760)
MAX_FILE_SIZE=10485760

# Если STORAGE_DRIVER=cloudinary:
# Зарегистрируйся на cloudinary.com и скопируй данные из Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=ijarauz/listings

# ─── 7. AI Чат и LLM (Ollama) ─────────────────────────────────
# URL инстанса Ollama (если развёрнут отдельным сервисом в Railway: http://ollama.railway.internal:11434)
OLLAMA_BASE_URL=http://ollama.railway.internal:11434
OLLAMA_MODEL=llama3

# URL микросервиса FastAPI (если развёрнут: http://ai-service.railway.internal:8000)
AI_SERVICE_URL=http://ai-service.railway.internal:8000

# ─── 8. Rate Limiting ─────────────────────────────────────────
# Глобальный лимит запросов для одного IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
